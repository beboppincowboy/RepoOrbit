type Viewer { login: String!, demo: Boolean! }
# fullName is "owner/name". syncState is "demo", "awaiting-sync" (selected), or "not-synchronized" (accessible but not selected).
# metadataStatus is the shared repository metadata refresh (null when the viewer has not selected it, and in Demo mode); activity is a separate fact. Neither exposes credentials or raw errors.
type Repository { id: ID!, fullName: String!, description: String!, private: Boolean!, selected: Boolean!, syncState: String!, metadataStatus: MetadataStatus, activity: ActivityStatus! }
# state is "not-scheduled", "queued", "running", "paused" or "dead". Times are RFC 3339. nextAttemptAt is set only while queued (retry or next poll).
# paused means waiting for a usable credential or access (no remote calls, no retries spent); dead needs an operator requeue. failureCode is a short machine code, never an error message.
# followSuspended means the viewer unstarred a followed repository: the selection is kept but not used for synchronization.
type MetadataStatus { state: String!, lastSuccessAt: String, nextAttemptAt: String, paused: Boolean!, failureCode: String, followSuspended: Boolean! }
# Activity (issues, pull requests, history) is synchronized separately from metadata; until activity ingestion exists synchronized is false for real repositories whatever the metadata state.
type ActivityStatus { synchronized: Boolean!, message: String!, issues: ActivityResourceStatus, futureResources: [String!]! }
type ActivityResourceStatus { phase: String!, boundary: String!, catchupThrough: String, lastSuccessAt: String, failureCode: String, jobState: String!, nextAttemptAt: String }
type Issue { id: ID!, repositoryId: ID!, number: Int!, title: String!, state: String!, url: String!, authorLogin: String, updatedAt: String!, labels: [String!]!, assignees: [String!]! }
# endCursor is the id of the last stored row scanned (even if access filtering hid it), so pass it as `after` to continue; null when the page held no rows.
# withheld counts items hidden because access could not be verified; retryAt (RFC 3339) is set when that is a rate limit.
type RepositoryConnection { nodes: [Repository!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type IssueConnection { nodes: [Issue!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
# Errors carry extensions.code: UNAUTHENTICATED (no real signed-in viewer) or ACCESS_UNVERIFIED (GitHub could not confirm access; extensions.retryAt is RFC 3339 when rate limited).
# selectedRepositories lists only repositories the viewer has selected (not every accessible one). first is 1..100; repositoryIds holds at most 100 ids.
type Query { viewer: Viewer, selectedRepositories(first: Int! = 20, after: ID): RepositoryConnection!, repository(id: ID!): Repository, issues(repositoryIds: [ID!]!, first: Int! = 20, after: ID, number: Int): IssueConnection! }

type EvidenceActor { id: ID!, login: String!, type: String! }
# reviewState: "merged", "closed", or for an open PR "awaiting_review", "commented", "approved" or "changes_requested" from each human
# non-author reviewer's latest approval or change request (docs/metrics-definitions.md 5.7); null while that open PR's review history is not imported.
type PullRequestEvidence { id: ID!, repositoryId: ID!, number: Int!, title: String!, state: String!, url: String!, createdAt: String!, updatedAt: String!, closedAt: String, mergedAt: String, author: EvidenceActor, reviewState: String }
type ReviewEvidence { id: ID!, repositoryId: ID!, pullRequestId: ID!, state: String!, body: String!, url: String!, submittedAt: String!, author: EvidenceActor }
type CommentEvidence { id: ID!, repositoryId: ID!, issueNumber: Int!, body: String!, url: String!, createdAt: String!, updatedAt: String!, author: EvidenceActor }
type PullRequestEvidenceConnection { nodes: [PullRequestEvidence!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type ReviewEvidenceConnection { nodes: [ReviewEvidence!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type CommentEvidenceConnection { nodes: [CommentEvidence!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type ChildResourceStatus { complete: Boolean!, pendingChildren: Int!, lastSuccessAt: String, failureCode: String, nextAttemptAt: String }
extend type ActivityStatus { pullRequests: ActivityResourceStatus, reviews: ChildResourceStatus, comments: ChildResourceStatus }
extend type Query { pullRequestEvidence(repositoryIds: [ID!]!, first: Int! = 20, after: ID, newestFirst: Boolean! = false): PullRequestEvidenceConnection!, reviewEvidence(repositoryIds: [ID!]!, first: Int! = 20, after: ID): ReviewEvidenceConnection!, commentEvidence(repositoryIds: [ID!]!, first: Int! = 20, after: ID): CommentEvidenceConnection! }

type ReleaseEvidence { id: ID!, repositoryId: ID!, name: String!, tagName: String!, body: String!, url: String!, createdAt: String!, updatedAt: String, publishedAt: String!, observedAt: String!, prerelease: Boolean!, author: EvidenceActor }
type IssueEventEvidence { id: ID!, repositoryId: ID!, issueId: ID!, issueNumber: Int!, event: String!, url: String!, createdAt: String!, observedAt: String!, actor: EvidenceActor, assignee: EvidenceActor, label: String }
type ReleaseEvidenceConnection { nodes: [ReleaseEvidence!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type IssueEventEvidenceConnection { nodes: [IssueEventEvidence!]!, endCursor: ID, hasNextPage: Boolean!, withheld: Int!, retryAt: String }
type IssueEventStatus { traversal: ActivityResourceStatus, historicalGap: Boolean! }
extend type ActivityStatus { releases: ActivityResourceStatus, issueEvents: IssueEventStatus }
extend type Query { releaseEvidence(repositoryIds: [ID!]!, first: Int! = 20, after: ID): ReleaseEvidenceConnection!, issueEventEvidence(repositoryIds: [ID!]!, first: Int! = 20, after: ID): IssueEventEvidenceConnection! }

extend type ActivityStatus { archived: Boolean! }

# One selected repository and one 7/30/90-day UTC window. Missing, unselected, and denied repos return null.
# Unverified access returns null with ACCESS_UNVERIFIED and an optional retryAt.
extend type Query { repositoryOverview(id: ID!, days: Int! = 30): RepositoryOverview }
scalar Time
scalar Int64

type MetricCoverage { covered: Boolean!, reason: String, through: Time }
type MetricCount { value: Int64, coverage: MetricCoverage! }
type MetricMedian { seconds: Int64, sampleSize: Int64, coverage: MetricCoverage! }
type MetricContributor { login: String!, isBot: Boolean!, pullRequestsOpened: Int64!, reviewsSubmitted: Int64!, commentsCreated: Int64! }
type MetricActor { login: String!, isBot: Boolean! }
type MetricTimelineEntry { kind: String!, occurredAt: Time!, sourceId: Int64!, actor: MetricActor, title: String!, label: String, number: Int64, url: String! }
type MetricTimelineCoverage { pullRequestMerged: MetricCoverage!, releasePublished: MetricCoverage!, issueOpened: MetricCoverage!, issueEvents: MetricCoverage! }
type MetricDailyPoint { day: Time!, issuesOpened: Int64, issuesClosed: Int64, pullRequestsOpened: Int64, pullRequestsMerged: Int64 }

type RepositoryOverview {
  fullName: String!
  syncState: String!
  activity: ActivityStatus!
  days: Int!
  windowStart: Time!
  now: Time!
  eventsCoveredFrom: Time
  openIssues: MetricCount!
  openPullRequests: MetricCount!
  openIssuesAssigned: MetricCount!
  staleOpenIssues: MetricCount!
  staleOpenPullRequests: MetricCount!
  unreviewedOpenPullRequests: MetricCount!
  unansweredOpenIssues: MetricCount!
  issuesOpened: MetricCount!
  issuesClosed: MetricCount!
  issuesReopened: MetricCount!
  pullRequestsOpened: MetricCount!
  pullRequestsMerged: MetricCount!
  releasesPublished: MetricCount!
  firstResponseTime: MetricMedian!
  issuesWithoutResponse: MetricCount!
  firstReviewTime: MetricMedian!
  pullRequestsNeverReviewed: MetricCount!
  mergeTime: MetricMedian!
  activeContributors: MetricCount!
  activeBotContributors: MetricCount!
  contributors: [MetricContributor!]!
  contributorsCoverage: MetricCoverage!
  timeline: [MetricTimelineEntry!]!
  timelineCoverage: MetricTimelineCoverage!
  daily: [MetricDailyPoint!]!
}

# All of the viewer's selected repositories (at most 100) for one 7/30/90-day UTC window, using repositoryOverview's metric definitions.
# repositoriesCounted are fully covered and summed; repositoriesSyncing are excluded from totals, the trend and Needs attention.
# AssignedToMe can include syncing repositories with covered issue data.
# withheld counts unverified selections, without naming them (retryAt when rate limited).
# reviewBacklog sums unreviewedOpenPullRequests. kind is "pr_awaiting_review", "issue_no_response" or "stale_issue".
extend type Query { crossRepositoryOverview(days: Int! = 30): CrossRepositoryOverview }
type AttentionItem { kind: String!, repositoryId: ID!, fullName: String!, number: Int64!, title: String!, url: String!, since: Time! }
# status is the issue's Board status, as repositoryBoard reports it; null when the repository's status labels are off.
type AssignedIssue { repositoryId: ID!, fullName: String!, number: Int64!, title: String!, url: String!, updatedAt: Time!, status: String }
type CrossDailyPoint { day: Time!, issuesOpened: Int64, pullRequestsMerged: Int64 }
type CrossRepositoryOverview {
  days: Int!
  windowStart: Time!
  now: Time!
  repositoriesCounted: Int!
  repositoriesSyncing: Int!
  withheld: Int!
  retryAt: String
  openIssues: MetricCount!
  reviewBacklog: MetricCount!
  needsAttention: [AttentionItem!]!
  assignedToMe: [AssignedIssue!]!
  daily: [CrossDailyPoint!]!
}

# One selected repository's Board snapshot (R15): its open issues (the 500 most recently updated), its closed issues
# (the 50 most recently closed) and the issue numbers in include (at most 100, for staged cards), each once.
# truncated is true when a cap left issues out. At most one repositoryBoard per request.
# Missing, unselected, and denied repos return null; unverified access returns null with ACCESS_UNVERIFIED and an optional retryAt.
extend type Query { repositoryBoard(id: ID!, include: [Int!]): RepositoryBoard }
type RepositoryBoard { statusLabels: Boolean!, truncated: Boolean!, issues: [BoardIssue!]! }
# status is "backlog", "todo", "in_progress", "in_review" or "done", null when statusLabels is false. multipleStatus
# flags an open issue carrying more than one status label (its status is the furthest-along one). updatedAt is RFC 3339.
type BoardIssue { number: Int!, title: String!, url: String!, state: String!, updatedAt: String!, authorLogin: String, labels: [String!]!, assignees: [String!]!, status: String, multipleStatus: Boolean! }
