type Viewer { login: String!, demo: Boolean! }
type Repository { id: ID!, name: String!, description: String! }
type Issue { id: ID!, repositoryId: ID!, title: String!, state: String! }
type RepositoryConnection { nodes: [Repository!]!, endCursor: ID, hasNextPage: Boolean! }
type IssueConnection { nodes: [Issue!]!, endCursor: ID, hasNextPage: Boolean! }
type Query { viewer: Viewer, repositories(first: Int! = 20, after: ID): RepositoryConnection!, issues(repositoryIds: [ID!]!, first: Int! = 20, after: ID): IssueConnection! }
