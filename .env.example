# Local development against the compose database.
DATABASE_URL=postgres://repoorbit:repoorbit@localhost:54329/repoorbit?sslmode=disable
API_ORIGIN=http://127.0.0.1:8080

# Demo mode: leave the GitHub values empty. Real sign-in: set both credentials and a key
# (see docs/github-app-setup.md). Setting only one of the two stops startup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# The GitHub App's URL name (github.com/apps/<slug>). Optional: it only enables the "Install the app" link.
GITHUB_APP_SLUG=
# The browser-facing address of the web app; GitHub redirects back here.
APP_URL=http://localhost:3000
# Shared secret for GitHub webhook signatures (X-Hub-Signature-256); required in real mode.
# Set the same value as the GitHub App's webhook secret: openssl rand -hex 32
WEBHOOK_SECRET=
